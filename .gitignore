# Repo root: only bootstrap files + src/ (add !/path/ here when adding CI, etc.)
/*
!/.github/
!/.github/**
!/src/
!/src/**
!/nginx/
!/nginx/**

!/.gitignore
!/.env.example
!/README.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/index.html
!/Dockerfile
!/docker-compose.yml
!/.dockerignore

# Node
node_modules/
dist/
*.local

# Local env and secrets
.env

# OS
.DS_Store
